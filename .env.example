# Lead Integration Middleware - environment variables (names and safe defaults only).
# Copy to .env for local development. Never commit real values.
# In Railway, set these per service and per environment (staging / production).

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development            # development | test | production
APP_ENV=local                   # local | test | staging | production (also embedded in API keys)
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent

# --- Database (required) ---------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lead_integration
DATABASE_POOL_MAX=10
DATABASE_SSL=disable            # disable (local / private network) | require | no-verify

# --- HTTP / security -------------------------------------------------------
TRUST_PROXY_HOPS=0              # 0 locally; on Railway it defaults to 2 (edge adds itself to X-Forwarded-For)
BODY_LIMIT_BYTES=65536
RATE_LIMIT_IP_PER_MIN=300
RATE_LIMIT_PLATFORM_DEFAULT_PER_MIN=60
API_KEY_LAST_USED_THROTTLE_SECONDS=300

# --- Encryption keys (required in every environment) -----------------------
# Lead email, phone, address, notes and raw payloads are encrypted with these.
# Generate each with: openssl rand -base64 32   (two different values, per environment).
# Losing APP_ENCRYPTION_KEY makes stored personal data unreadable: keep it in the secret store.
APP_ENCRYPTION_KEY=
APP_BLIND_INDEX_KEY=

# --- Lead processing ------------------------------------------------------
DEFAULT_PHONE_REGION=AU         # region for phone numbers without +country code (assumption, confirm)
DUPLICATE_WINDOW_DAYS=30        # same phone/email within N days -> flagged possible duplicate
LEAD_RETENTION_DAYS=730         # placeholder until retention periods are agreed (Q16)
DELIVERY_CONCURRENCY=4          # parallel delivery batches per worker instance
DELIVERY_BATCH_SIZE=10          # jobs fetched per batch (each settled individually)
# Retry policy. Production-like defaults: 8 retries, 60s first delay, 6h max.
# Short values below make retry / dead-letter scenarios visible within a minute locally.
DELIVERY_RETRY_LIMIT=3
DELIVERY_RETRY_DELAY_SECONDS=5
DELIVERY_RETRY_DELAY_MAX_SECONDS=30

# --- Consent recordings and SFTP --------------------------------------------
# RECORDING_STORAGE_DIR=    encrypted recordings when RECORDING_STORE=local (set by setup:local)
RECORDING_MAX_MB=50
RECORDING_RETENTION_DAYS=730    # placeholder until retention is agreed (Q16)
CONSENT_OVERDUE_HOURS=48        # lead without its recording after this long -> "overdue"

# SFTP server for consent recordings: SFTPGo on Railway (docs/RAILWAY_DEPLOYMENT.md).
# Leave unset locally: the app runs without an SFTP server. All of these are needed together.
# SFTP_PUBLIC_HOST=            Railway TCP proxy host providers connect to
# SFTP_PUBLIC_PORT=            Railway TCP proxy port
# SFTPGO_API_URL=              e.g. http://sftpgo.railway.internal:8080 (private network)
# SFTPGO_ADMIN_USER= / SFTPGO_ADMIN_PASSWORD=
# SFTPGO_S3_ENDPOINT=          bucket endpoint as SFTPGo reaches it (defaults to S3_ENDPOINT)
# S3_ENDPOINT= / S3_REGION= / S3_ACCESS_KEY_ID= / S3_SECRET_ACCESS_KEY=   Railway Bucket credentials
# S3_FORCE_PATH_STYLE=true
# UPLOADS_BUCKET=              bucket SFTPGo writes provider uploads to
# RECORDING_STORE=local        "s3" on Railway (with RECORDINGS_BUCKET)
# RECORDINGS_BUCKET=

# --- Admin dashboard ------------------------------------------------------
# Safari refuses Secure cookies on http://localhost, so local development uses false.
# Must be true anywhere served over HTTPS.
ADMIN_COOKIE_SECURE=false
ADMIN_SESSION_HOURS=8
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_LOCKOUT_THRESHOLD=5
ADMIN_LOCKOUT_MINUTES=15
ADMIN_LOGIN_RATE_PER_MIN=10
REPORT_TIMEZONE=Australia/Sydney

# --- HubSpot destination (worker only) - DISABLED for local development -----
# Leave HUBSPOT_ENABLED=false: leads go to the local mock destination and nothing is sent to HubSpot.
# Enable only after explicit approval, with a HubSpot TEST portal token.
HUBSPOT_ENABLED=false
# HUBSPOT_PRIVATE_APP_TOKEN=
# HUBSPOT_BASE_URL=https://api.hubapi.com
