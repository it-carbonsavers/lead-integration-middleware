{
  "openapi": "3.1.0",
  "info": {
    "title": "Lead Integration Middleware: Provider API",
    "version": "1.0.0",
    "description": "One-way API for lead providers to submit live-transfer leads. LOCAL DEVELOPMENT BUILD: no data leaves the machine; deliveries go to a local mock destination."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Per-platform API key: lim_<env>_<prefix>_<secret>"
      }
    },
    "schemas": {
      "LeadSubmission": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1"
          },
          "external_lead_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9._:/-]+$"
          },
          "transferred_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "customer": {
            "type": "object",
            "properties": {
              "first_name": {
                "type": "string"
              },
              "last_name": {
                "type": "string"
              },
              "phone": {
                "type": "string",
                "minLength": 6,
                "maxLength": 32
              },
              "email": {
                "type": "string"
              },
              "address": {
                "type": "object",
                "properties": {
                  "line1": {
                    "type": "string"
                  },
                  "line2": {
                    "type": "string"
                  },
                  "city": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string"
                  },
                  "postcode": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9 -]{3,10}$"
                  },
                  "country": {
                    "type": "string",
                    "pattern": "^[A-Z]{2}$"
                  }
                },
                "required": ["line1"],
                "additionalProperties": false
              }
            },
            "required": ["first_name", "last_name", "phone"],
            "additionalProperties": false
          },
          "agent": {
            "type": "object",
            "properties": {
              "external_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9._:/-]+$"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            },
            "required": ["external_id"],
            "additionalProperties": false
          },
          "campaign": {
            "type": "string"
          },
          "product_interest": {
            "type": "string"
          },
          "energy_plan": {
            "type": "string"
          },
          "consent": {
            "type": "object",
            "properties": {
              "verbal_consent": {
                "type": "boolean"
              },
              "captured_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "recording_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9._:/-]+$"
              }
            },
            "required": ["verbal_consent"],
            "additionalProperties": false
          },
          "notes": {
            "type": "string"
          },
          "extra": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_]{1,64}$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 500
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "required": [
          "schema_version",
          "external_lead_id",
          "transferred_at",
          "customer",
          "agent",
          "consent"
        ],
        "additionalProperties": false
      },
      "SubmitResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "lead_ref": {
            "type": "string",
            "description": "Our reference for the lead, e.g. LD-01JCZ8M4Q7X3..."
          },
          "external_lead_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "duplicate": {
            "type": "boolean",
            "description": "true when this request repeated an earlier one; nothing new was created"
          },
          "possible_duplicate": {
            "type": "boolean",
            "description": "same phone or email seen recently (any provider); lead still accepted"
          },
          "received_at": {
            "type": "string"
          }
        },
        "required": [
          "lead_ref",
          "external_lead_id",
          "status",
          "duplicate",
          "possible_duplicate",
          "received_at"
        ]
      },
      "LeadStatus": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "lead_ref": {
            "type": "string"
          },
          "external_lead_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "consent_status": {
            "type": "string"
          },
          "possible_duplicate": {
            "type": "boolean"
          },
          "received_at": {
            "type": "string"
          },
          "delivered_at": {
            "type": ["string", "null"]
          }
        },
        "required": [
          "lead_ref",
          "external_lead_id",
          "status",
          "consent_status",
          "possible_duplicate",
          "received_at",
          "delivered_at"
        ]
      },
      "LeadList": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "lead_ref": {
                  "type": "string"
                },
                "external_lead_id": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "consent_status": {
                  "type": "string"
                },
                "possible_duplicate": {
                  "type": "boolean"
                },
                "received_at": {
                  "type": "string"
                },
                "delivered_at": {
                  "type": ["string", "null"]
                }
              },
              "required": [
                "lead_ref",
                "external_lead_id",
                "status",
                "consent_status",
                "possible_duplicate",
                "received_at",
                "delivered_at"
              ]
            }
          },
          "total": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "page_size": {
            "type": "number"
          }
        },
        "required": ["items", "total", "page", "page_size"]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                }
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": ["type", "title", "status", "request_id"]
      }
    }
  },
  "paths": {
    "/v1/ping": {
      "get": {
        "summary": "Check connectivity and credentials",
        "responses": {
          "200": {
            "description": "Authenticated"
          },
          "401": {
            "description": "Missing, malformed, unknown, revoked or expired API key (same response for all)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Platform suspended, or source IP not in the platform's allow-list",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded; see Retry-After header",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable; safe to retry",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/leads": {
      "post": {
        "summary": "Submit one lead",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{8,128}$"
            },
            "description": "Optional. Repeating a request with the same key returns the original answer."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeadSubmission"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Duplicate: the same external_lead_id (or Idempotency-Key) was already received. The original lead is returned; nothing is delivered again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "202": {
            "description": "Accepted and queued for delivery",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON or invalid Idempotency-Key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, unknown, revoked or expired API key (same response for all)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Platform suspended, or source IP not in the platform's allow-list",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency-Key already used for a different lead",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Body larger than 64 KB",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type is not application/json",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed; `errors` lists field path and code (never values)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded; see Retry-After header",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable; safe to retry",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List your own leads (newest first)",
        "parameters": [
          {
            "name": "external_lead_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Your own lead id (exact)"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "received_from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "received_to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of your leads",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadList"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, unknown, revoked or expired API key (same response for all)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Platform suspended, or source IP not in the platform's allow-list",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded; see Retry-After header",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable; safe to retry",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/leads/{lead_ref}": {
      "get": {
        "summary": "Status of one of your leads",
        "parameters": [
          {
            "name": "lead_ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lead status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadStatus"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, unknown, revoked or expired API key (same response for all)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Platform suspended, or source IP not in the platform's allow-list",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No lead with that reference from your platform",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded; see Retry-After header",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable; safe to retry",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  }
}
